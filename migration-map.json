{
  "$schema": "anarix-migration-map/1",
  "repositoryRole": {
    "A": "github.com/ghttushar/anarix-ui-old \u2014 engineering source of truth",
    "B": "this repo \u2014 visual source of truth"
  },
  "appRoot": "frontend",
  "stack": [
    "react@18",
    "vite@5",
    "typescript@5",
    "tailwindcss@3",
    "shadcn/ui",
    "react-router@6",
    "@tanstack/react-query",
    "recharts"
