    {
      "from": "src/pages/Alerts.tsx",
      "to": "src/pages/SignalsPage.tsx"
    },
    {
      "from": "src/components/actions/",
      "to": "src/components/signals/"
    },
    {
      "from": "src/state/actionsStore.tsx",
      "to": "src/state/signalsStore.tsx"
    },
    {
      "from": "src/state/selectionStore.tsx",
      "to": "src/state/signalSelectionStore.tsx"
    },
    {
      "from": "AlertDetailPanel",
      "to": "SignalDetailPanel"
    },
    {
      "from": "AlertsToolbar",
      "to": "SignalsToolbar"
    },
    {
      "from": "ExpandedAlertBody",
      "to": "ExpandedSignalBody"
    }
  ],
